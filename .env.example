OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional model for the Firefox recording fallback.
OPENROUTER_TRANSCRIPTION_MODEL=openai/whisper-large-v3
# Fish Audio handles push-to-talk transcription and brief agent status speech when configured.
FISH_API_KEY=
FISH_ASR_MODEL=transcribe-1-pro
FISH_TTS_MODEL=drama-3
# Optional: choose a voice model from Fish Audio's Voice Library or My Voices.
FISH_TTS_VOICE_ID=933563129e564b19a115bedd57b7406a
# Optional delivery tag, e.g. [warm]. Speed range: 0.5–2.0; volume range: -20–20.
FISH_TTS_DIRECTION=
FISH_TTS_SPEED=1
FISH_TTS_VOLUME=0
# Save uploaded demo recordings locally for debugging.
DEBUG_STORE_VOICE_CLIPS=false
PORT=3001
# Set this to your browser frontend's exact origin, if it uses a different port.
FRONTEND_ORIGIN=http://localhost:5173
ENABLE_CODE_EXECUTION=false
